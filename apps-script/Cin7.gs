function validateCin7Query_(body){const numericSku=typeof body?.numericSku==='string'?body.numericSku.trim():'',sku=typeof body?.sku==='string'?body.sku.trim():'';if(!/^[0-9]{4,5}$/.test(numericSku)||!sku||sku.length>256||/[\u0000-\u001f\u007f]/.test(sku)||(sku!==numericSku&&!sku.endsWith('~'+numericSku)))throw Error('INVALID_SKU');return {numericSku,sku};}
function cin7Quantity(value){if(value===undefined||value===null)return null;if(typeof value==='number'&&(!Number.isFinite(value)||Math.abs(value)>Number.MAX_SAFE_INTEGER))throw Error('INVALID_RESPONSE');const raw=String(value);if(!/^-?\d{1,18}(\.\d{1,6})?$/.test(raw))throw Error('INVALID_RESPONSE');const negative=raw.startsWith('-'),abs=negative?raw.slice(1):raw;return format((negative?-1n:1n)*units(abs));}
function signedCin7Units(value){return value.startsWith('-')?-units(value.slice(1)):units(value);}
function summarizeCin7Rows(rows,sku){const groups=new Map();for(const row of rows){if(typeof row?.SKU!=='string'||row.SKU.trim()!==sku)throw Error('INVALID_RESPONSE');const location=String(row.Location??'').trim(),bin=String(row.Bin??'').trim();if(location.length>256||bin.length>256)throw Error('INVALID_RESPONSE');const key=JSON.stringify([location,bin]);let item=groups.get(key);if(!item){item={location,bin,available:'0',onHand:'0',allocated:'0',onOrder:'0',records:0};groups.set(key,item);}item.records++;for(const [field,source]of [['available','Available'],['onHand','OnHand'],['allocated','Allocated'],['onOrder','OnOrder']]){const value=cin7Quantity(row[source]);item[field]=value===null||item[field]===null?null:format(signedCin7Units(item[field])+signedCin7Units(value));}}
 return [...groups.values()].sort((a,b)=>a.location.localeCompare(b.location)||a.bin.localeCompare(b.bin,undefined,{numeric:true}));}
function cin7CallBudget_(){return locked_(function(){var p=props_(),date=Utilities.formatDate(new Date(),'Pacific/Auckland','yyyy-MM-dd'),v=JSON.parse(p.getProperty('CIN7_BUDGET')||'{}'),minute=Math.floor(Date.now()/60000);if(v.date!==date)v={date:date,day:0,minute:minute,count:0};if(v.minute!==minute){v.minute=minute;v.count=0;}if(v.day>=1000||v.count>=30)throw Error('LOCAL_LIMIT');v.day++;v.count++;p.setProperty('CIN7_BUDGET',JSON.stringify(v));});}
function lookupCin7_(req){var query;try{query=validateCin7Query_(req);}catch{return {ok:false,errorCode:'INVALID_SKU'};}var p=props_(),account=p.getProperty('CIN7_ACCOUNT_ID'),key=p.getProperty('CIN7_APPLICATION_KEY');if(!account||!key)return {ok:false,errorCode:'NOT_CONFIGURED'};var cache=CacheService.getScriptCache(),cacheKey='cin7:'+digest_(account+key+query.sku),cached=cache.get(cacheKey);if(cached){var value=JSON.parse(cached);if(Date.now()-Date.parse(value.fetchedAt)<5000)return Object.assign({},value,{cached:true,apiCalls:0});}
 var inflight=cacheKey+':busy',acquired=locked_(function(){if(cache.get(inflight))return false;cache.put(inflight,'1',120);return true;});if(!acquired)return {ok:false,errorCode:'BUSY'};
 try{var rows=[],calls=0,started=Date.now();for(var page=1;page<=3;page++){if(Date.now()-started>30000)throw Error('TIMEOUT');cin7CallBudget_();calls++;var url='https://inventory.dearsystems.com/ExternalApi/v2/ref/productavailability?Sku='+encodeURIComponent(query.sku)+'&Page='+page+'&Limit=1000&NonZeroProductsOnly=false';var res;try{res=UrlFetchApp.fetch(url,{method:'get',headers:{'api-auth-accountid':account,'api-auth-applicationkey':key,Accept:'application/json'},muteHttpExceptions:true,followRedirects:false});}catch{throw Error('NETWORK');}var code=res.getResponseCode();if(code===401||code===403)throw Error('AUTH');if(code===429||code===503)throw Error('UPSTREAM_LIMIT');if(code!==200)throw Error('UPSTREAM');var text=res.getContentText();if(text.length>2000000)throw Error('TOO_MANY_ROWS');var data;try{data=JSON.parse(text);}catch{throw Error('INVALID_RESPONSE');}if(data.Page!==undefined&&Number(data.Page)!==page)throw Error('INVALID_RESPONSE');var list=data.ProductAvailabilityList;if(!Array.isArray(list)||list.length>1000||list.some(function(r){return typeof r.SKU!=='string'||r.SKU.trim()!==query.sku;}))throw Error('INVALID_RESPONSE');rows=rows.concat(list);var total=data.Total===undefined?null:Number(data.Total);if(total!==null&&(!Number.isInteger(total)||total<0))throw Error('INVALID_RESPONSE');if(total!==null&&rows.length>total)throw Error('INVALID_RESPONSE');if((total!==null&&rows.length===total)||(total===null&&list.length<1000)){var result=Object.assign({ok:true},query,{groups:summarizeCin7Rows(rows,query.sku),fetchedAt:new Date().toISOString(),apiCalls:calls,cached:false});var serialized=JSON.stringify(result);if(serialized.length<80000)cache.put(cacheKey,serialized,10);return result;}if(!list.length)throw Error('INCOMPLETE');}throw Error('TOO_MANY_ROWS');}catch(e){var allowed=['TIMEOUT','LOCAL_LIMIT','NETWORK','AUTH','UPSTREAM_LIMIT','UPSTREAM','INVALID_RESPONSE','TOO_MANY_ROWS','INCOMPLETE'];return {ok:false,errorCode:allowed.includes(e.message)?e.message:'INVALID_RESPONSE'};}finally{cache.remove(inflight);}}

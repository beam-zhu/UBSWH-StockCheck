// Independent UBSWH-StockCheck project. Never paste over UBSWH-3D.
var STOCKCHECK_APP_='UBSWH-StockCheck', STOCKCHECK_VERSION_='0.1.0-test';
var REPORT_HEADERS_=['id','receivedAt','fileId','location','operator','deviceId','deviceName','round','startedAt','checkedAt','baselineAt','version','basis','missing','extra','mismatch','matched','expected','actual','lines','hasCin7'];
function props_(){return PropertiesService.getScriptProperties();}
function digest_(text){return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,String(text),Utilities.Charset.UTF_8).map(function(b){return ('0'+((b+256)%256).toString(16)).slice(-2);}).join('');}
function constantEqual_(a,b){a=String(a);b=String(b);var n=a.length^b.length;for(var i=0;i<Math.max(a.length,b.length);i++)n|=(a.charCodeAt(i)||0)^(b.charCodeAt(i)||0);return n===0;}
function random_(){return Utilities.getUuid().replace(/-/g,'')+Utilities.getUuid().replace(/-/g,'');}
function locked_(fn){var lock=LockService.getScriptLock();if(!lock.tryLock(15000))throw Error('BUSY');try{return fn();}finally{lock.releaseLock();}}
function response_(data,status){return {ok:(status||200)<400,status:status||200,data:data};}
function output_(result){return ContentService.createTextOutput(JSON.stringify(result)).setMimeType(ContentService.MimeType.JSON);}
function ready_(){if(props_().getProperty('APP_ID')!==STOCKCHECK_APP_)throw Error('NOT_INITIALIZED');}
// Run only from the new project's editor. ADMIN_PASSWORD must be >=20 characters.
// It creates a NEW spreadsheet and folder; it never opens or modifies the old project.
function initializeStockCheck(){return locked_(function(){var p=props_();if(p.getProperty('APP_ID'))throw Error('Already initialized; existing storage was preserved');var password=p.getProperty('ADMIN_PASSWORD');if(!password||password.length<10)throw Error('Set ADMIN_PASSWORD (10+ characters) in Script Properties first');var ss=SpreadsheetApp.create('UBSWH-StockCheck · Reports TEST');var sheet=ss.getSheets()[0];sheet.setName('Reports');sheet.appendRow(REPORT_HEADERS_);sheet.setFrozenRows(1);var folder=DriveApp.createFolder('UBSWH-StockCheck · Reports TEST');var secret=random_(),salt=random_();p.setProperties({APP_ID:STOCKCHECK_APP_,REPORT_SHEET_ID:ss.getId(),REPORT_FOLDER_ID:folder.getId(),SIGNING_SECRET:secret,ADMIN_SALT:salt,ADMIN_HASH:digest_(salt+password)});p.deleteProperty('ADMIN_PASSWORD');return {spreadsheet:ss.getUrl(),folder:folder.getUrl(),status:'Initialized independent TEST storage'};});}
function sign_(text){return Utilities.base64EncodeWebSafe(Utilities.computeHmacSha256Signature(text,props_().getProperty('SIGNING_SECRET'))).replace(/=+$/,'');}
function issueToken_(role){var raw=role+'.'+Math.floor(Date.now()/1000+(role==='admin'?28800:86400))+'.'+random_();return raw+'.'+sign_(raw);}
function tokenValid_(token,role){if(typeof token!=='string'||token.length>300)return false;var a=token.split('.');if(a.length!==4||a[0]!==role||!/^\d+$/.test(a[1]))return false;var exp=Number(a[1]),now=Date.now()/1000;if(exp<=now||exp>now+(role==='admin'?28860:86460))return false;return constantEqual_(a[3],sign_(a.slice(0,3).join('.')));}
function admin_(req){if(!tokenValid_(req.token,'admin'))throw Error('UNAUTHORIZED');}
function scanner_(req){if(!tokenValid_(req.scannerToken,'scanner'))throw Error('SESSION');}
function budget_(name,limit){var c=CacheService.getScriptCache();return locked_(function(){var key='budget:'+name+':'+Math.floor(Date.now()/60000),n=Number(c.get(key)||0);if(n>=limit)throw Error('LOCAL_LIMIT');c.put(key,String(n+1),120);});}
function login_(req){budget_('login',12);var pw=typeof req.password==='string'?req.password:'';if(!pw||pw.length>1024||!constantEqual_(digest_(props_().getProperty('ADMIN_SALT')+pw),props_().getProperty('ADMIN_HASH')))throw Error('UNAUTHORIZED');return {token:issueToken_('admin'),expiresIn:28800};}
function sheet_(){return SpreadsheetApp.openById(props_().getProperty('REPORT_SHEET_ID')).getSheetByName('Reports');}
function textCell_(v){v=String(v===undefined?'':v);return /^[=+@\-\t\r]/.test(v)?"'"+v:v;}
function readText_(v){v=String(v);return /^'[=+@\-\t\r]/.test(v)?v.slice(1):v;}
function index_(){var s=sheet_(),last=s.getLastRow();return last<2?[]:s.getRange(2,1,last-1,REPORT_HEADERS_.length).getDisplayValues();}
function reportRow_(r){return {report_id:r[0],received_at:r[1],location:readText_(r[3]),operator_name:readText_(r[4]),device_id:r[5],device_name:readText_(r[6]),round:Number(r[7]),started_at:r[8],checked_at:r[9],baseline_at:r[10],baseline_version:r[11],quantity_basis:readText_(r[12]),missing_skus:Number(r[13]),extra_skus:Number(r[14]),mismatch_skus:Number(r[15]),match_skus:Number(r[16]),expected_total:r[17],counted_total:r[18],line_count:Number(r[19]),has_cin7:r[20]==='1'};}
function upload_(body){scanner_(body);var p=normalizeReport(body.payload),id='r_'+digest_(canonicalJSON(p));if(body.id!==id)throw Error('CHECKSUM');budget_('upload',60);return locked_(function(){var ss=sheet_(),old=index_().find(function(r){return r[0]===id;});if(old)return {ok:true,id:id,receivedAt:old[1]};var receivedAt=new Date().toISOString(),folder=DriveApp.getFolderById(props_().getProperty('REPORT_FOLDER_ID')),name=id+'.json',matches=folder.getFilesByName(name),file;
 // Recover an orphan file after a prior file-write/index-write interruption.
 if(matches.hasNext()){file=matches.next();var existing=JSON.parse(file.getBlob().getDataAsString('UTF-8'));if(existing.id!==id||digest_(canonicalJSON(normalizeReport(existing.payload)))!==id.slice(2))throw Error('CORRUPT_REPORT');receivedAt=existing.receivedAt;}else file=folder.createFile(name,JSON.stringify({id:id,receivedAt:receivedAt,payload:p}),MimeType.PLAIN_TEXT);
 var s=reportSummary(p),row=[id,receivedAt,file.getId(),p.location,p.operator,p.deviceId,p.deviceName,p.round,p.startedAt,p.checkedAt,p.snapshot.fetchedAt,p.snapshot.version,p.snapshot.quantityBasis,s.missing,s.extra,s.mismatch,s.matched,s.expectedTotal,s.countedTotal,p.rows.length,p.rows.some(function(r){return !!r.baseline;})?'1':'0'];var range=ss.getRange(ss.getLastRow()+1,1,1,row.length);range.setNumberFormat('@');range.setValues([row.map(textCell_)]);SpreadsheetApp.flush();return {ok:true,id:id,receivedAt:receivedAt};});}
function filterReports_(rows,q){var location=String(q.location||'').trim().toUpperCase(),query=String(q.q||'').trim().toLowerCase(),status=q.status||'all',from=q.from?Date.parse(q.from):null,to=q.to?Date.parse(q.to):null;if((from!==null&&!Number.isFinite(from))||(to!==null&&!Number.isFinite(to)))throw Error('INVALID_FILTER');return rows.filter(function(r){var diff=r.missing_skus+r.extra_skus+r.mismatch_skus,ts=Date.parse(r.received_at);return (!location||r.location.toUpperCase().includes(location))&&(!query||[r.operator_name,r.device_name,r.device_id].some(function(v){return v.toLowerCase().includes(query);}))&&(status!=='differences'||diff>0)&&(status!=='matched'||diff===0)&&(from===null||ts>=from)&&(to===null||ts<to);});}
function listReports_(req){admin_(req);var q=req.query||{},rows=filterReports_(index_().map(reportRow_),q).sort(function(a,b){return b.received_at.localeCompare(a.received_at)||b.report_id.localeCompare(a.report_id);}),total=rows.length,limit=[25,50,100].includes(Number(q.limit))?Number(q.limit):25,page=Math.min(Math.max(1,parseInt(q.page,10)||1),Math.max(1,Math.ceil(total/limit))),differences=rows.filter(function(r){return r.missing_skus+r.extra_skus+r.mismatch_skus>0;}).length;return {items:rows.slice((page-1)*limit,page*limit),page:page,limit:limit,total:total,stats:{total:total,differences:differences,matched:total-differences,devices:new Set(rows.map(function(r){return r.device_id;})).size}};}
function detail_(req){admin_(req);if(!/^r_[a-f0-9]{64}$/.test(req.id||''))throw Error('INVALID_ID');var folder=props_().getProperty('REPORT_FOLDER_ID'),cache=CacheService.getScriptCache(),key='report:v1:'+digest_(folder+':'+req.id),cached=cache.get(key);if(cached){try{var hit=JSON.parse(cached);if(hit.id===req.id&&hit.payload)return hit;}catch{}}
 var row=index_().find(function(r){return r[0]===req.id;});if(!row)throw Error('NOT_FOUND');var file=DriveApp.getFileById(row[2]),parents=file.getParents(),valid=false;while(parents.hasNext()){if(parents.next().getId()===folder)valid=true;}if(!valid)throw Error('CORRUPT_REPORT');var saved=JSON.parse(file.getBlob().getDataAsString('UTF-8')),p=normalizeReport(saved.payload);if(saved.id!==req.id||'r_'+digest_(canonicalJSON(p))!==req.id)throw Error('CORRUPT_REPORT');var result={id:req.id,receivedAt:row[1],payload:p,summary:reportSummary(p)},serialized=JSON.stringify(result);if(Utilities.newBlob(serialized).getBytes().length<90000){try{cache.put(key,serialized,300);}catch{}}return result;}

function inventory_(force){var p=props_(),id=p.getProperty('INVENTORY_FILE_ID'),saved=null;try{if(id)saved=JSON.parse(DriveApp.getFileById(id).getBlob().getDataAsString('UTF-8'));}catch{}if(saved&&!force&&Date.now()-Date.parse(saved.fetchedAt)<1800000)return Object.assign({},saved,{stale:false});return locked_(function(){
 // Recheck after waiting for another refresh.
 var latestId=p.getProperty('INVENTORY_FILE_ID');try{if(latestId){var latest=JSON.parse(DriveApp.getFileById(latestId).getBlob().getDataAsString('UTF-8'));if(!force&&Date.now()-Date.parse(latest.fetchedAt)<1800000)return Object.assign({},latest,{stale:false});saved=latest;}}catch{}
 var urls=['https://docs.google.com/spreadsheets/d/1w1RvdGh_5LfIaxKHv0P-egK5kKzjLVZx/export?format=csv','https://docs.google.com/spreadsheets/d/e/2PACX-1vSQCYB3mcz_EhOijQai4eMuJsuXgQYyJ2Q6LjxPsfgZcmqrdSlaepE7TRhXMEZgig/pub?output=csv'];
 for(var i=0;i<urls.length;i++){try{var res=UrlFetchApp.fetch(urls[i],{muteHttpExceptions:true,followRedirects:true});if(res.getResponseCode()!==200)continue;var csv=res.getContentText('UTF-8');if(csv.length>20000000||/^\s*</.test(csv))continue;var inv=Object.assign(parseReport(csv),{version:digest_(csv).slice(0,12),fetchedAt:new Date().toISOString()});var content=JSON.stringify(inv);if(latestId)DriveApp.getFileById(latestId).setContent(content);else{var f=DriveApp.getFolderById(p.getProperty('REPORT_FOLDER_ID')).createFile('inventory-cache.json',content,MimeType.PLAIN_TEXT);p.setProperty('INVENTORY_FILE_ID',f.getId());}return Object.assign({},inv,{stale:false});}catch{}}
 if(saved)return Object.assign({},saved,{stale:true,refreshError:'库存源暂不可用，沿用上次快照'});throw Error('INVENTORY_UNAVAILABLE');});}
function settings_(req){admin_(req);var p=props_();if(req.save){if(!/^[a-f0-9-]{36}$/i.test(req.accountId||'')||!req.applicationKey||req.applicationKey.length>2048||/[\u0000-\u001f]/.test(req.applicationKey))throw Error('INVALID_SETTINGS');p.setProperties({CIN7_ACCOUNT_ID:req.accountId.trim(),CIN7_APPLICATION_KEY:req.applicationKey.trim(),CIN7_UPDATED_AT:new Date().toISOString()});}return {configured:!!p.getProperty('CIN7_APPLICATION_KEY'),accountId:p.getProperty('CIN7_ACCOUNT_ID')||'',updatedAt:p.getProperty('CIN7_UPDATED_AT')||null,connectionTested:false};}
function route_(req){ready_();if(!req||typeof req.action!=='string')throw Error('INVALID_ACTION');switch(req.action){case 'scanner_config':return {enabled:true,configured:!!props_().getProperty('CIN7_APPLICATION_KEY'),scannerToken:issueToken_('scanner'),environment:'google-test'};case 'inventory':if(req.refresh)budget_('inventory-refresh',3);return inventory_(req.refresh===true);case 'upload_report':return upload_(req);case 'admin_login':return login_(req);case 'list_reports':return listReports_(req);case 'report_detail':return detail_(req);case 'report_csv':var d=detail_(req),csv=cloudReportCSV(d.payload,d.id,d.receivedAt);return {csv:req.lang==='en'?translateReport(csv,'en'):csv};case 'cin7_settings':return settings_(req);case 'cin7_lookup':scanner_(req);return lookupCin7_(req);default:throw Error('INVALID_ACTION');}}
function stockCheckRpc(req){try{return response_(route_(req));}catch(err){return error_(err);}}
function doGet(e){try{var page=e&&e.parameter&&e.parameter.page;if(page==='manager'||page==='cin7'){var root=ScriptApp.getService().getUrl(),html=HtmlService.createHtmlOutputFromFile(page==='manager'?'Manager':'Cin7').getContent();html=html.replaceAll('__MANAGER_URL__',root+'?page=manager').replaceAll('__SETTINGS_URL__',root+'?page=cin7').replaceAll('__SCANNER_URL__',props_().getProperty('FRONTEND_URL')||'#');return HtmlService.createHtmlOutput(html).setTitle('UBSWH-StockCheck · Google TEST').addMetaTag('viewport','width=device-width, initial-scale=1');}var action=e&&e.parameter&&e.parameter.action;if(action==='health')return output_(response_({app:STOCKCHECK_APP_,version:STOCKCHECK_VERSION_,initialized:props_().getProperty('APP_ID')===STOCKCHECK_APP_}));if(action==='scanner_config'||action==='inventory')return output_(response_(route_({action:action})));return output_(response_({error:'POST_REQUIRED'},405));}catch(err){return output_(error_(err));}}
function error_(err){var code=String(err&&err.message||'FAILED'),allowed=['UNAUTHORIZED','SESSION','NOT_INITIALIZED','BUSY','LOCAL_LIMIT','CHECKSUM','CORRUPT_REPORT','INVALID_FILTER','INVALID_ID','NOT_FOUND','INVALID_SETTINGS','INVALID_ACTION','INVENTORY_UNAVAILABLE'];return response_({ok:false,error:allowed.includes(code)?code:'REQUEST_FAILED'},code==='UNAUTHORIZED'?401:code==='NOT_FOUND'?404:400);}
function doPost(e){try{if(!e||!e.postData||e.postData.contents.length>1000000)throw Error('INVALID_ACTION');return output_(response_(route_(JSON.parse(e.postData.contents))));}catch(err){return output_(error_(err));}}

function resetStockCheckAdminPassword(){return locked_(function(){ready_();var p=props_(),password=p.getProperty('ADMIN_PASSWORD');if(!password||password.length<10)throw Error('请先在脚本属性中设置至少10位的 ADMIN_PASSWORD');var salt=random_();p.setProperties({ADMIN_SALT:salt,ADMIN_HASH:digest_(salt+password),SIGNING_SECRET:random_()});p.deleteProperty('ADMIN_PASSWORD');console.log('管理口令已重设，表格和报告保持不变。请刷新管理页后登录。');});}
